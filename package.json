  },
  "scripts": {
    "dev": "concurrently \"contentlayer2 dev\" \"next dev\"",
    "build": "contentlayer2 build && next build",
    "preview": "next build && next start",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false",
    "lint:fix": "tsc --noEmit --pretty false",
    "email:dev": "email dev --dir src/components/emails -p 3001",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe --latest",
    "typecheck": "contentlayer2 build && rm -rf .next/dev && tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "prepare": "husky install",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "pnpm": {
    "autoInstallPeers": false
  },
